+        AP_Baro::SimpleAtmosphere(sim_alt * 0.001f, sigma, delta, theta);
+        _recent_press = SSL_AIR_PRESSURE * delta;
+        _recent_temp = KELVIN_TO_C(SSL_AIR_TEMPERATURE * theta);
     }
