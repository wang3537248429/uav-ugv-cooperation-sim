<?xml version="1.0"?>
<package format="3">
  <name>ap_navigation</name>
  <version>1.0.0</version>
  <description>Point-cloud mapping and saved-map localization for indoor UAV waypoint flight</description>
  <maintainer email="contributors@aeromind-sim.invalid">AeroMind Sim contributors</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
