      <visual name="rotor_3_visual_motor_top">
        <pose>0 0 -0.02144 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.67 0.67 0.67</scale>
            <uri>model://x500_base/meshes/5010Bell.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>
    <!--
      Competition-only guards and balloon needle stay outside PX4 files.
      The generator merges these visuals into base_link and removes this
      placeholder body/joint so they add no unstable lightweight rigid body.
    -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>rotor_0_joint</joint_name>
      <joint_name>rotor_1_joint</joint_name>
      <joint_name>rotor_2_joint</joint_name>
      <joint_name>rotor_3_joint</joint_name>
    </plugin>
    <!-- Dedicated physics feed: do not use the GUI scene stream (about 60Hz). -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <!-- Garden also requires this flag for the containing model pose. -->
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>200</update_frequency>
    </plugin>
    <!--
      The official PX4 motor positions and rotation labels are retained.
      The thrust constant is calibrated for the scaled derivative and the
      bridge's 1500 us hover output; flight remains fully driven by ArduPilot
      PWM through an explicit model namespace.
    -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <robotNamespace>drone</robotNamespace>
      <actuator_number>0</actuator_number>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>7.84532e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <robotNamespace>drone</robotNamespace>
      <actuator_number>1</actuator_number>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>7.84532e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <robotNamespace>drone</robotNamespace>
      <actuator_number>2</actuator_number>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>7.84532e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <robotNamespace>drone</robotNamespace>
      <actuator_number>3</actuator_number>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>7.84532e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    </plugin>
  </model>
