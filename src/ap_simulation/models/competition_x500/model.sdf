<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.9">
  <model name="competition_x500">
    <!--
      PX4 x500_base is vendored unchanged under model://x500_base.
      Its 492.15 mm motor-axis diagonal is scaled by 0.67 to 329.74 mm.
      The include pose overrides the upstream 0.24 m spawn pose so that the
      competition world remains the single authority for vehicle placement.
    -->
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
