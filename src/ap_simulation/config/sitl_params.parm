# ============================================================
# ArduPilot SITL 参数文件 (Copter 4.5+)
# ============================================================

# --- 电池 (4S, 16.8V) ---
SIM_BATT_VOLTAGE,16.8
BATT_MONITOR,4
BATT_CAPACITY,5200

# --- 机架与电机 (匹配仿真模型 1.6kg / 3.2kgf 总拉力) ---
FRAME_CLASS,1
FRAME_TYPE,1
MOT_PWM_MIN,1100
MOT_PWM_MAX,1900
MOT_SPIN_MIN,0.0
MOT_SPIN_ARM,0.0
MOT_SPIN_MAX,1.0
MOT_THST_EXPO,0.0
MOT_THST_HOVER,0.50

# --- EKF3 (ExternalNav via VISION_POSITION_ESTIMATE) ---
GPS_TYPE,0
AHRS_EKF_TYPE,3
EK3_ENABLE,1
EK3_SRC1_POSXY,6
EK3_SRC1_POSZ,6
EK3_SRC1_VELXY,6
EK3_SRC1_VELZ,6
EK3_SRC1_YAW,6
EK3_FLOW_USE,1

# --- ArduPilot ExternalNav/VISO接口 ---
VISO_TYPE,1

# --- 原生光流 + 下视测距 (bridge enables these at runtime when selected) ---
FLOW_TYPE,5
RNGFND1_TYPE,10
RNGFND1_ORIENT,25
RNGFND1_MIN_CM,5
RNGFND1_MAX_CM,800
VISO_TYPE,1

# --- 解锁检查 (仿真全部关闭) ---
ARMING_CHECK,0
ARMING_RUDDER,1.0
BRD_SAFETY_DEFLT,0
DISARM_DELAY,0

# --- 飞行模式 / GUIDED速度限制 ---
# 当前实物动力为 1.6kg / 3.2kgf, 推重比约2:1。
# 仿真主问题不是最大推力, 而是 ExternalNav + ExternalNav 闭环可跟踪速度。
GUID_OPTIONS,8
ANGLE_MAX,1000
PSC_ANGLE_MAX,10.0
ATC_ANG_RLL_P,3.0
ATC_ANG_PIT_P,3.0
ATC_ANG_YAW_P,2.0
ATC_RAT_RLL_P,0.08
ATC_RAT_RLL_I,0.04
ATC_RAT_RLL_D,0.001
ATC_RAT_PIT_P,0.08
ATC_RAT_PIT_I,0.04
ATC_RAT_PIT_D,0.001
ATC_RAT_YAW_P,0.12
ATC_RAT_YAW_I,0.02
ATC_RAT_YAW_D,0.0
ATC_ACCEL_R_MAX,30000
ATC_ACCEL_P_MAX,30000
ATC_ACCEL_Y_MAX,12000
LOIT_SPEED,10
LOIT_ACC_MAX,5
WPNAV_SPEED,10
WPNAV_SPEED_UP,30
WPNAV_SPEED_DN,35
WPNAV_ACCEL,5
WPNAV_ACCEL_Z,45
WPNAV_RADIUS,35
PSC_POSXY_P,0.15
PSC_VELXY_P,1.20
PSC_VELXY_I,0.10
PSC_VELXY_D,0.05
PSC_POSZ_P,0.45
PSC_VELZ_P,0.60

# --- 失控保护 (仿真关闭) ---
FS_GCS_ENABLE,0
FS_THR_ENABLE,0
FS_CRASH_CHECK,0

# --- 地理围栏 (关闭) ---
FENCE_ENABLE,0

# --- 日志 (关闭节省磁盘) ---
LOG_BACKEND_TYPE,0

# --- 降落 ---
# Gentle contact for the scaled landing skids; high descent speed plus residual
# horizontal motion can make the light Gazebo model slide before LAND settles.
LAND_SPEED,20
