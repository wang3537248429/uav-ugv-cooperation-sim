<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ap_simulation</name>
  <version>1.0.0</version>
  <description>Gazebo physics, synthetic vision and ArduPilot SITL competition simulation</description>
  <maintainer email="contributors@aeromind-sim.invalid">AeroMind Sim contributors</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>actuator_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>ap_gazebo_bridge</exec_depend>
  <exec_depend>ap_mavlink_bridge</exec_depend>
  <exec_depend>ap_mission</exec_depend>
  <exec_depend>ap_perception</exec_depend>
  <exec_depend>ap_navigation</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
